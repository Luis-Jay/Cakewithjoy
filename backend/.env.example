# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL=mysql+pymysql://bmsuser:bmspassword@localhost:3306/bms
# Production (PlanetScale / Railway):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/bms?ssl_ca=/path/to/ca.pem

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@cakewjoy.com
SENDGRID_FROM_NAME=Cake with Joy

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
DEBUG=true
